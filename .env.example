# ThreatForge ML Server — V3 Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Laptop 2 is private. Do not expose port 8001 publicly.

# ── Core server ────────────────────────────────────────────────────────────
# Shared secret between Laptop 1 and Laptop 2.
# Must match ML_API_KEY on Laptop 1.
ML_API_KEY=replace-with-a-strong-random-secret

# Laptop 2 should listen on all interfaces so Tailscale can reach it.
# Use 0.0.0.0 for production deployment (or your Tailscale IP).
HOST=0.0.0.0
PORT=8001

# ── Model registry ─────────────────────────────────────────────────────────
MODEL_REGISTRY_FILE=models/registry.json
DEFAULT_MODEL=phishing

# ── URL / request limits ───────────────────────────────────────────────────
MAX_URL_LENGTH=4096
CONNECT_TIMEOUT=5.0
READ_TIMEOUT=10.0
REQUEST_TIMEOUT=20.0
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=5242880
MAX_HTML_BYTES=2097152

# ── Threat intelligence (optional) ────────────────────────────────────────
# Set THREAT_INTEL_PROVIDER=virustotal and add your API key to enable.
# Leave as "none" if you do not have a VirusTotal API key.
THREAT_INTEL_PROVIDER=none
VIRUSTOTAL_API_KEY=

# ── LLM explanation layer (optional) ──────────────────────────────────────
# Set LLM_ENABLED=true to enable the local Qwen3 explanation layer.
# The LLM must be running as a separate service on LLM_HOST:LLM_PORT.
# The ML server still works without it -- deterministic explanation is used.
LLM_ENABLED=false
LLM_HOST=127.0.0.1
LLM_PORT=11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT=30.0

# ── Deepfake upload size limits ────────────────────────────────────────────
# Maximum raw upload sizes for each media type (bytes).
# Change these if you need to support larger files.
DEEPFAKE_MAX_IMAGE_BYTES=20971520     # 20 MB
DEEPFAKE_MAX_VIDEO_BYTES=524288000    # 500 MB
DEEPFAKE_MAX_AUDIO_BYTES=104857600    # 100 MB

# Maximum decoded image pixel count (width * height) to prevent
# decompression-bomb attacks. Default is 25 million pixels (~5000x5000).
DEEPFAKE_MAX_IMAGE_PIXELS=25000000

# ── Deepfake inference concurrency ─────────────────────────────────────────
# Maximum simultaneous GPU inference calls.
# 1 = fully sequential (safest for 6 GB VRAM).
# 2 = allows one pipelined request (default, works with DualBranchResNet v4).
# Increase only if you have tested VRAM headroom.
DEEPFAKE_MAX_CONCURRENT_INFERENCES=2

# ── Deepfake LLM explanation (optional) ───────────────────────────────────
# Set to true to request an LLM-generated explanation for deepfake results.
# Requires LLM_ENABLED=true and a running Ollama service.
# When false (default), the ML result is returned without LLM prose.
# The ML verdict is NEVER changed by the LLM.
DEEPFAKE_LLM_EXPLANATION_ENABLED=false

# LLM timeout specifically for deepfake explanation calls (seconds).
# Deepfake prompts are shorter than URL-analysis prompts, so 20s is enough.
DEEPFAKE_LLM_TIMEOUT=20.0

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for development.
# Example: "http://localhost:3000,https://app.threatforge.io"
CORS_ORIGINS=*
